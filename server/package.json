{
  "name": "student-dashboard-server",
  "version": "1.0.0",
  "description": "AI-Powered Student Dashboard Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test MONGOMS_VERSION=7.0.14 MONGOMS_DOWNLOAD_DIR=D:\\.mongodb-binaries TEMP=D:\\.mongodb-tmp TMP=D:\\.mongodb-tmp jest --runInBand --forceExit",
    "test:coverage": "cross-env NODE_ENV=test MONGOMS_VERSION=7.0.14 MONGOMS_DOWNLOAD_DIR=D:\\.mongodb-binaries TEMP=D:\\.mongodb-tmp TMP=D:\\.mongodb-tmp jest --runInBand --forceExit --coverage",
    "postinstall": "pip3 install --break-system-packages -r requirements.txt || pip install --break-system-packages -r requirements.txt",
    "test:unstop": "node collectors/tests/unstopTest.js",
    "test:devfolio": "node collectors/tests/devfolioTest.js",
    "test:all-collectors": "node tests/runAllTests.js",
    "seed:demo": "node scripts/seedDemoAccount.js"
  },
  "dependencies": {
    "@sentry/node": "^9.0.0",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "canvas": "^3.2.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.7.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.9",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "openai": "^6.33.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^3.11.174",
    "pdfreader": "^3.0.8",
    "string-similarity": "^4.0.4",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  },
  "mongodbMemoryServer": {
    "version": "7.0.14",
    "downloadDir": "D:\\.mongodb-binaries"
  }
}
